# gRPC listen address.
RUSTI2_BIND_ADDR=0.0.0.0:50051

# Cloudflare account ID (dashboard → overview, right column).
CLOUDFLARE_ACCOUNT_ID=

# R2 API token credentials with Object Read & Write on the buckets below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Comma-separated list of buckets this instance may serve.
RUSTI2_ALLOWED_BUCKETS=cotab-avatars-pending,cotab-avatars

# Cloudflare API token with Queues Read & Write; required when
# RUSTI2_QUEUES is set.
CLOUDFLARE_TOKEN=

# Logical queue name -> Cloudflare queue ID mappings.
RUSTI2_QUEUES=avatar-moderation=

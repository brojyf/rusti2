# gRPC listen address.
RUSTI2_BIND_ADDR=0.0.0.0:3002

# Cloudflare account ID (dashboard → overview, right column).
CLOUDFLARE_ACCOUNT_ID=

# R2 API token credentials with Object Read & Write on the buckets granted
# below. These are rusti2's own R2 credentials and are deliberately broader
# than any single caller: RUSTI2_CALLERS is what narrows them down per service.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Who may call this instance, and what each of them may do. JSON array; the
# process refuses to start if it is missing, malformed, or grants a caller
# nothing. There is no separate bucket allowlist — a bucket is reachable
# exactly when some caller has a scope in it.
#
#   name    stable service name; appears in denial logs, never the token
#   token   the bearer token that service sends; >= 24 chars, generate with
#           `openssl rand -hex 32`. Real values live in the Keys doc, not here.
#   methods any of PresignPut, Stat, Download, Upload, Delete
#   scopes  "bucket/key-prefix" entries; a trailing * is cosmetic, and
#           "bucket/*" or a bare "bucket" means the whole bucket
#
# Grant the narrowest set that still works. cotab-api hands out upload URLs and
# cleans up replaced objects but never moves bytes itself; cogate-indexer moves
# bytes but never presigns.
RUSTI2_CALLERS=[{"name":"cotab-api","token":"REPLACE_ME","methods":["PresignPut","Stat","Delete"],"scopes":["cotab-avatars-pending/*","cotab-avatars/*"]},{"name":"cogate-indexer","token":"REPLACE_ME","methods":["Download","Upload","Delete"],"scopes":["cotab-avatars-pending/*","cotab-avatars/*"]}]
